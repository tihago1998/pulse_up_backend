    <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6"><di:waypoint x="745" y="292"/><di:waypoint x="745" y="145"/><di:waypoint x="840" y="145"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7"><di:waypoint x="950" y="145"/><di:waypoint x="1022" y="145"/></bpmndi:BPMNEdge>
