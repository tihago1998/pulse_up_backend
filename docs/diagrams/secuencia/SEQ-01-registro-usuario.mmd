sequenceDiagram
    autonumber
    actor U as Usuario
    participant A as App Android<br/>(RegisterScreen)
    participant API as API Flask<br/>(auth: rutas y servicio)
    participant DB as SQLite<br/>(pulseup.db)

    U->>A: Ingresa nombre, correo, contraseña y su confirmación
    A->>A: Valida campos no vacíos, contraseña de 8 o más<br/>caracteres y que ambas contraseñas coincidan
    A->>API: POST /api/auth/register<br/>{nombre, email, password}
    API->>DB: Verifica si el correo ya existe
    DB-->>API: Resultado
    alt Correo disponible
        API->>DB: Inserta usuario (contraseña con hash) con rol Usuario
        DB-->>API: id_usuario
        API-->>A: 201 {message, id_usuario}
        A-->>U: Muestra registro exitoso y vuelve al inicio de sesión
    else Correo ya registrado (409)
        API-->>A: {error}
        A-->>U: "Ese correo ya está registrado"
    else Faltan campos (400)
        API-->>A: {error}
        A-->>U: "Faltan datos requeridos"
    end
