    <bpmndi:BPMNShape id="Shape_E0" bpmnElement="E0"><dc:Bounds x="877" y="297" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_T4" bpmnElement="T4"><dc:Bounds x="840" y="112" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_G2" bpmnElement="G2"><dc:Bounds x="1022" y="122" width="46" height="46"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_T5" bpmnElement="T5"><dc:Bounds x="1140" y="112" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_T6" bpmnElement="T6"><dc:Bounds x="1290" y="407" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_T7" bpmnElement="T7"><dc:Bounds x="1440" y="282" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_E1" bpmnElement="E1"><dc:Bounds x="1627" y="297" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_TM" bpmnElement="TM"><dc:Bounds x="1177" y="512" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_T8" bpmnElement="T8"><dc:Bounds x="1290" y="497" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_E2" bpmnElement="E2"><dc:Bounds x="1477" y="512" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="163" y="145"/><di:waypoint x="240" y="145"/></bpmndi:BPMNEdge>
