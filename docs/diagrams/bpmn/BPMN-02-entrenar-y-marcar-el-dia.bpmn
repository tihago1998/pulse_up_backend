    <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9"><di:waypoint x="1045" y="168"/><di:waypoint x="1045" y="530"/><di:waypoint x="1177" y="530"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10"><di:waypoint x="1250" y="145"/><di:waypoint x="1270" y="145"/><di:waypoint x="1270" y="440"/><di:waypoint x="1290" y="440"/></bpmndi:BPMNEdge>
