<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PulseUp" targetNamespace="http://pulseup.app/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_PulseUp" name="PulseUp: registro y seguimiento diario de hábitos" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Registro y seguimiento diario de hábitos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Usuario" name="Usuario">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema PulseUp (app Android + API Flask)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Abre la app">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Iniciar sesión (o registrarse)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Validar credenciales y generar token">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="¿Credenciales válidas?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Mostrar Home: saludo, frase motivadora y calendario">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T4" name="Elegir fecha en la semana o el calendario">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="¿Qué desea hacer?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Escribir hábito y elegir categoría">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T7" name="Marcar o desmarcar un hábito">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Cierra sesión">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T8" name="Actualizar estado del hábito">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T6" name="Guardar hábito en la fecha elegida">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T9" name="Refrescar lista, progreso y calendario">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="¿Todos los hábitos del día cumplidos?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T10" name="Mostrar llama morada en el día">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G5">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" sourceRef="G1" targetRef="T1" name="No" />
    <bpmn:sequenceFlow id="F5" sourceRef="G1" targetRef="T3" name="Sí" />
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" sourceRef="G2" targetRef="T5" name="Registrar hábito" />
    <bpmn:sequenceFlow id="F9" sourceRef="G2" targetRef="T7" name="Marcar hábito" />
    <bpmn:sequenceFlow id="F10" sourceRef="G2" targetRef="End" name="Cerrar sesión" />
    <bpmn:sequenceFlow id="F11" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F12" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F13" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="F14" sourceRef="T8" targetRef="G3" />
    <bpmn:sequenceFlow id="F15" sourceRef="G3" targetRef="T9" />
    <bpmn:sequenceFlow id="F16" sourceRef="T9" targetRef="G4" />
    <bpmn:sequenceFlow id="F17" sourceRef="G4" targetRef="T10" name="Sí" />
    <bpmn:sequenceFlow id="F18" sourceRef="G4" targetRef="G5" name="No" />
    <bpmn:sequenceFlow id="F19" sourceRef="T10" targetRef="G5" />
    <bpmn:sequenceFlow id="F20" sourceRef="G5" targetRef="T4" name="Seguir usando la app" />
  </bpmn:process>
